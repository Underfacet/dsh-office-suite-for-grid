{
  "name": "默认样式集",
  "description": "常规中文报告默认排版：标题 1–3 黑体（22/16/14pt），正文宋体小四（12pt）、1.5 倍行距、两端对齐。字段结构见 docs/P2-设计.md §3.3（FormatRule）。注：paragraph.firstLineIndentChars 为预留字段，当前 Host/引擎未消费（首行缩进暂不生效）。",
  "rules": [
    {
      "target": "heading",
      "level": 1,
      "font": { "name": "黑体", "sizePt": 22, "bold": true },
      "paragraph": {
        "lineSpacing": 1.5,
        "spaceBeforePt": 12,
        "spaceAfterPt": 12,
        "align": "center"
      }
    },
    {
      "target": "heading",
      "level": 2,
      "font": { "name": "黑体", "sizePt": 16, "bold": true },
      "paragraph": {
        "lineSpacing": 1.5,
        "spaceBeforePt": 12,
        "spaceAfterPt": 6,
        "align": "left"
      }
    },
    {
      "target": "heading",
      "level": 3,
      "font": { "name": "黑体", "sizePt": 14, "bold": true },
      "paragraph": {
        "lineSpacing": 1.5,
        "spaceBeforePt": 6,
        "spaceAfterPt": 6,
        "align": "left"
      }
    },
    {
      "target": "body",
      "font": { "name": "宋体", "sizePt": 12, "bold": false },
      "paragraph": {
        "lineSpacing": 1.5,
        "spaceBeforePt": 0,
        "spaceAfterPt": 0,
        "align": "justify",
        "firstLineIndentChars": 2
      }
    }
  ]
}

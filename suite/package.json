{
  "name": "dsh-office-suite-for-grid",
  "version": "1.0.0",
  "description": "DSH office & grid drawing suite: Office docs/spreadsheets read, edit and format; Visio grid diagrams; CAD-to-PDF smart conversion.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.0 <0.3.0",
    "node": ">=18"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "host/ops/*.js",
    "engines/*.ps1",
    "engines/*.py",
    "requirements-office.txt",
    "symbols/**/*.json",
    "symbols/*.md",
    "templates/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
